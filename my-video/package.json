    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src",
    "prepare:media": "python3 scripts/prepare-media.py && node scripts/score.mjs",
    "render": "remotion render AlderShowcase out/alder-hackathon-90s.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:preview": "remotion render AlderShowcase out/alder-preview.mp4 --scale=0.5 --crf=25",
    "postrender": "node scripts/finalize.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
